+                return undefined;
+        } else {
+            const proto = Object.getPrototypeOf(node);
+            if ((proto !== Object.prototype && proto !== null) || typeof key !== "string" ||
+                key === "__proto__" || key === "constructor" || key === "prototype" || key === "$cid")
+                return undefined;
+        }
+        const descriptor = Object.getOwnPropertyDescriptor(node, key);
+        if (!descriptor || !("value" in descriptor)) return undefined;
+        parents.push({ node, key });
+        node = descriptor.value;
+    }
+    if (typeof node !== "string") return undefined;
+    let next: unknown = applyTextDelta(node, event.diff.diff);
+    if (next === node) return state;
